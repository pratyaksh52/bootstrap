#!/bin/sh
# copy: send stdin to the system clipboard.
# clip.exe is only on PATH under WSL, and comes before wl-copy so WSLg's
# Wayland clipboard doesn't win over the Windows one.

if command -v pbcopy >/dev/null 2>&1; then
  exec pbcopy
elif command -v clip.exe >/dev/null 2>&1; then
  exec clip.exe
elif command -v wl-copy >/dev/null 2>&1; then
  exec wl-copy
elif command -v xclip >/dev/null 2>&1; then
  exec xclip -selection clipboard
elif command -v xsel >/dev/null 2>&1; then
  exec xsel --clipboard --input
fi

printf 'copy: no clipboard utility found\n' >&2
exit 1
