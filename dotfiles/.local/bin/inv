#!/bin/sh
# inv: pick a file with fzf and copy its absolute path to the clipboard.

command -v fzf >/dev/null 2>&1 || {
  printf 'inv: fzf not found\n' >&2
  exit 1
}

file="$(fzf --preview='bat --color=always {}')" || exit

if command -v realpath >/dev/null 2>&1; then
  path="$(realpath "$file")" || exit
else
  path="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$file")" || exit
fi

# copy sits next to this script, so this works even when ~/.local/bin isn't on PATH.
printf '%s' "$path" | "$(dirname "$0")/copy"
